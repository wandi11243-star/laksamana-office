{
  "expo": {
    "name": "Laksamana Muda",
    "slug": "laksamana-muda",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "laksamanamuda",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F4"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.laksamanamuda.app"
    },
    "android": {
      "package": "com.laksamanamuda.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F6F4"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
