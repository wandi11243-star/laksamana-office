# =====================================================================
# Aturan cache untuk seluruh modul Laksamana Muda.
# ---------------------------------------------------------------------
# MASALAH YANG DITUTUP
# Server tidak pernah mengirim header Cache-Control, jadi browser MENEBAK
# sendiri berapa lama boleh menyimpan halaman — biasanya berjam-jam.
# Akibatnya sesudah rilis, sebagian kru tetap memakai versi lama tanpa
# tahu, dan melapor "revisinya kok belum masuk". Kalau yang dirilis adalah
# perbaikan bug, sebagian orang tetap terkena bug-nya berhari-hari.
#
# CARA KERJANYA
# `no-cache` BUKAN berarti "jangan simpan". Browser tetap menyimpan, tapi
# WAJIB bertanya dulu ke server sebelum memakainya. Kalau tidak ada
# perubahan, server menjawab "304 Not Modified" — beberapa ratus byte,
# tanpa mengirim ulang isinya. Jadi ini hampir tidak menambah beban, tapi
# versi baru langsung terpakai begitu dirilis.
#
# Semua diapit <IfModule>: kalau modulnya tidak ada di server, barisnya
# diabaikan. Tanpa itu, satu directive tak dikenal membuat SELURUH situs
# balas 500 — dan .htaccess yang salah mematikan semua modul sekaligus.
# =====================================================================

# =====================================================================
# Route laksamanamuda.id/office DIMATIKAN.
# ---------------------------------------------------------------------
# Aplikasi ini kini beralamat di team.laksamanamuda.id. Tiga alamat berikut
# menunjuk FOLDER FISIK YANG SAMA — folder tempat berkas ini berada:
#
#     laksamanamuda.id/office     <- dimatikan di sini
#     office.laksamanamuda.id
#     team.laksamanamuda.id
#
# Karena satu folder, menghapus foldernya akan mematikan ketiganya
# sekaligus. Maka yang dimatikan hanyalah JALAN MASUK lewat domain pokok:
# permintaan yang datang dengan Host laksamanamuda.id (atau www-nya) ditolak
# 404, sementara kedua subdomain lewat tanpa tersentuh.
#
# Kalau nanti ingin dialihkan saja (supaya tautan lama tidak mati mendadak),
# ganti baris RewriteRule di bawah menjadi:
#     RewriteRule ^(.*)$ https://team.laksamanamuda.id/$1 [R=301,L]
# =====================================================================
# =====================================================================
# HTTPS diwajibkan.
# ---------------------------------------------------------------------
# Sertifikat Let's Encrypt SUDAH terpasang untuk team.laksamanamuda.id,
# tapi punya sertifikat tidak sama dengan memakainya: tanpa aturan di
# bawah, orang yang mengetik "team.laksamanamuda.id" tanpa "https://"
# dilayani lewat HTTP biasa dan browser menandainya "Not secure".
#
# Yang dipertaruhkan bukan label di address bar. Halaman pertama modul ini
# adalah form Nama Pengguna + PIN. Lewat HTTP, PIN itu melintas sebagai
# teks polos: siapa pun yang sejalur (wifi kafe, kantor, ISP) bisa
# membacanya. Sesi lm_session yang tersimpan juga ikut terkirim polos di
# tiap permintaan berikutnya.
#
# DUA syarat, bukan satu. Di hosting yang TLS-nya diputus lebih dulu oleh
# proxy, %{HTTPS} bisa tetap "off" walau pengunjung sudah lewat https —
# mengalihkannya lagi berarti lingkaran tanpa ujung. X-Forwarded-Proto
# adalah keterangan dari proxy itu; kalau salah satu bilang sudah https,
# pengalihan tidak dijalankan.
#
# 302, BUKAN 301, untuk sekarang. 301 disimpan browser SELAMANYA — kalau
# aturan ini ternyata melingkar di server, seluruh kru tidak bisa membuka
# aplikasi sampai masing-masing membersihkan cache-nya sendiri. Sesudah
# dipastikan jalan (buka http://team.laksamanamuda.id, harus mendarat di
# https tanpa berputar), ganti R=302 menjadi R=301 supaya browser berhenti
# menanyakannya berulang kali.
# =====================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Route laksamanamuda.id/office dimatikan lebih dulu. Ditaruh di ATAS
  # pengalihan https supaya alamat yang memang sudah mati langsung 404,
  # tidak dibelokkan dulu ke https baru kemudian 404.
  RewriteCond %{HTTP_HOST} ^(www\.)?laksamanamuda\.id$ [NC]
  RewriteRule ^ - [R=404,L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
</IfModule>

<IfModule mod_headers.c>

  # ---- Berkas KODE: selalu tanya dulu ke server ----
  # Modul-modul ini satu berkas HTML berisi seluruh aplikasinya, jadi
  # index.html yang basi = aplikasi yang basi. .js/.css/.json ikut karena
  # namanya tidak pernah berubah saat isinya berubah (tidak ada hash),
  # sehingga browser tidak punya cara lain untuk tahu.
  <FilesMatch "\.(html|htm|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # ---- Gambar & font: boleh disimpan lama ----
  # Logo dan gambar nyaris tidak pernah berubah, dan kalaupun berubah,
  # tampil versi lama sebentar tidak merusak apa pun — beda dengan kode.
  <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

</IfModule>

# ETag mati supaya perbandingan versi memakai Last-Modified saja. Di hosting
# bersama, ETag ikut memuat nomor inode berkas — nilainya berubah begitu
# berkas dipindah atau di-upload ulang meski isinya sama, jadi justru bikin
# unduh ulang yang tidak perlu.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Cadangan lama jangan bisa diunduh dari web. Berkas seperti
# index.html.sso-backup adalah salinan aplikasi versi sebelumnya; tidak ada
# alasan pengunjung boleh mengambilnya.
#
# Ditulis dua kali dengan sengaja: `Require` hanya ada di Apache 2.4, dan
# `Order/Deny` hanya di 2.2. Menulis salah satu saja berarti bertaruh pada
# versi server — yang salah bukan cuma tidak berfungsi, tapi membuat
# seluruh situs balas 500. Penjaga <IfModule> memastikan hanya yang cocok
# yang dijalankan.
<FilesMatch "\.(bak|backup|sso-backup|old|orig|save|swp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
