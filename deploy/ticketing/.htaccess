# =====================================================================
# SITUS CUSTOMER TICKETING — pelindung di lapisan web server
# ---------------------------------------------------------------------
# Berkas ini ikut ter-deploy bersama index.html. Semua aturan dibungkus
# <IfModule> supaya hosting yang tidak punya modulnya tidak balas HTTP 500 —
# situs yang mati total jauh lebih buruk daripada satu header yang hilang.
# =====================================================================

<IfModule mod_headers.c>
  # Peramban dilarang menebak-nebak jenis berkas. Tanpa ini, berkas yang
  # kebetulan berisi HTML bisa dijalankan sebagai halaman meski kita
  # menyajikannya sebagai gambar/JSON.
  Header always set X-Content-Type-Options "nosniff"

  # HALAMAN INI TIDAK BOLEH DIBINGKAI SITUS LAIN. Alur belinya berisi tombol
  # bayar; kalau bisa dibingkai, halaman palsu dapat menumpuk lapisan tak
  # terlihat di atasnya dan menipu orang menekan sesuatu yang tidak ia lihat
  # (clickjacking).
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"

  # Alamat halaman ini memuat kode pesanan & access_token pada hash-nya.
  # Referrer dipangkas supaya tautan itu tidak ikut terkirim ke situs lain.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Situs ini tidak butuh kamera, mikrofon, maupun lokasi.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # HALAMANNYA JANGAN DI-CACHE.
  # index.html adalah SATU berkas berisi seluruh aplikasi. Berkali-kali terjadi
  # perbaikan sudah ter-deploy tapi yang terbuka masih salinan lama, dan waktu
  # habis mencari bug yang sebenarnya sudah tidak ada. Isinya kecil; memuat
  # ulang jauh lebih murah daripada satu jam salah paham.
  <FilesMatch "\.(html)$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Daftar isi folder tidak perlu bisa dibuka orang.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
