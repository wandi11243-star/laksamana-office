# Office data exports (staff PINs + customer PII). Managed in Google Sheets,
# not in the code repo. Only deploy/ is shipped (via FTP) anyway.
database/

# Paket upload backend — berisi config.php dengan password. Jangan masuk repo.
*.zip
.pratinjau/
node_modules/

# Keluaran graphify (graf kode). Beberapa megabyte, hasil mesin, dan bisa
# dibangun ulang kapan saja dengan `graphify update .` — tidak ada gunanya
# masuk repo, dan graph.json cuma akan jadi sumber konflik merge tiap kali dua
# orang membangunnya. Yang MASUK repo justru sumbernya: tools/graph-src/.
graphify-out/

# Laporan keuangan CFO — bertanda "PRIBADI DAN RAHASIA", memuat neraca &
# gaji. Jangan pernah masuk repo: repo ini publik-adjacent dan riwayat git
# tidak bisa dibersihkan tanpa menulis ulang seluruh cabang.
Laporan keuangan*.pdf

# Laporan POS mentah. Satu berkas memuat SELURUH transaksi sebulan — nilai tiap
# bill, jamnya, kasirnya, dan nama tamu yang memesan. Modul Analytics
# mengurainya di peramban dan cuma mengirim ringkasannya ke server; berkas
# aslinya tidak punya alasan untuk ikut ke repo, apalagi ke repo yang bisa
# dibuka orang lain. Ukurannya juga ~750 KB per bulan.
Sales Recapitulation*.xlsx
Sales Recapitulation*.csv

# Promotion Report dari POS: satu baris per promo yang dipakai di sebuah bill,
# berikut NOMOR BILL-nya — dan nomor bill di POS ini memuat stempel waktu
# transaksinya. Alasan yang sama dengan berkas POS di atas. Dipakai
# tools/uji-promo.js kalau ada; kalau tidak, ujinya MELEWAT dengan jelas.
Promotion Report*.xlsx
Promotion Report*.csv

# Cancel Menu Detail Report dari POS: satu baris per item yang dibatalkan,
# berikut NOMOR BILL-nya (memuat stempel waktu) DAN nama akun yang
# membatalkannya. Isinya catatan siapa membatalkan apa dan alasannya — data
# kepegawaian, bukan cuma angka penjualan. Dipakai tools/uji-void.js kalau
# ada; kalau tidak, bagian itu MELEWAT dengan jelas.
Cancel Menu Detail Report*.xlsx
Cancel Menu Detail Report*.csv

# Berkas jadwal shift dari HR: satu berkas memuat nama seluruh kru satu
# divisi berikut Employee ID Talenta-nya. Alasan yang sama dengan berkas POS
# di atas — dipakai menguji impor, tidak pernah masuk repo.
SCHEDULE*.xlsx
SCHEDULE*.csv
